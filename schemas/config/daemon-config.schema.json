{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/config/daemon-config.schema.json",
  "title": "DaemonConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["prod", "test"],
      "default": "test"
    },
    "bindAddr": {
      "type": "string",
      "default": "127.0.0.1:19192"
    },
    "dataDir": {
      "type": "string",
      "default": "~/.kura-test"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "default": "info"
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultProvider": {
          "type": "string",
          "default": ""
        },
        "defaultModel": {
          "type": "string",
          "default": ""
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 30000
        },
        "defaultMaxRetries": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "openaiCompatible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseURL": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "apiKeyEnv": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "streamFirstChunkTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "streamIdleTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "streamMaxDurationMs": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cliPath": {
              "type": "string"
            },
            "defaultModel": {
              "type": "string"
            },
            "workDir": {
              "type": "string"
            }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cliPath": {
              "type": "string"
            },
            "defaultModel": {
              "type": "string"
            },
            "workDir": {
              "type": "string"
            }
          }
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "description": "Persistence settings (Stage 10.2).",
      "properties": {
        "readers": {
          "type": "integer",
          "minimum": 0,
          "default": 2,
          "description": "Query-only reader connections beside the single writer. 0 = every read goes through the writer (pre-pool behaviour)."
        },
        "synchronous": {
          "type": "string",
          "enum": ["full", "normal"],
          "default": "full",
          "description": "SQLite synchronous mode for every connection (WAL). full syncs the WAL on every commit. normal syncs at checkpoints only: never corrupts the database, but the last commits before a power loss or OS crash can be lost. Env: KURA_STORE_SYNCHRONOUS."
        }
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "connectorId": {
              "type": "string",
              "default": "discord-main"
            },
            "displayName": {
              "type": "string",
              "default": "Discord Main"
            },
            "deliveryMode": {
              "type": "string",
              "enum": ["gateway"],
              "default": "gateway"
            },
            "botToken": {
              "type": "string"
            },
            "botTokenEnv": {
              "type": "string"
            },
            "requireMention": {
              "type": "boolean",
              "default": true
            },
            "respondInDM": {
              "type": "boolean",
              "default": true
            },
            "allowedGuildIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedChannelIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "connectorId": {
              "type": "string",
              "default": "slack-main"
            },
            "displayName": {
              "type": "string",
              "default": "Slack Main"
            },
            "apiBaseUrl": {
              "type": "string"
            },
            "botTokenSecretRef": {
              "type": "string"
            },
            "oauthClientId": {
              "type": "string"
            },
            "oauthClientSecret": {
              "type": "string"
            },
            "oauthClientSecretEnv": {
              "type": "string"
            },
            "oauthApiBaseUrl": {
              "type": "string"
            },
            "workspaceBindingId": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "botUserId": {
              "type": "string"
            },
            "allowedChannelIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedDMUserIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedDMUserGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
