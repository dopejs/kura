{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/chat-query.request.schema.json",
  "title": "ChatQueryRequest",
  "type": "object",
  "required": ["query"],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0
    },
    "threadId": {
      "type": "string",
      "minLength": 1
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "disabled"]
        }
      }
    },
    "responseFormat": {
      "type": "object",
      "description": "The final reply must be a JSON value conforming to `schema`. Only a subset of JSON Schema is accepted (see agent-runtime-program.md 2.8); a schema using anything else is refused with 400. A reply that still does not conform after one correction fails with 502. Not available on the streamed query.",
      "required": ["type", "name", "schema"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["json_schema"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "object"
        }
      }
    }
  }
}
