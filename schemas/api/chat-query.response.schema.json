{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/chat-query.response.schema.json",
  "title": "ChatQueryResponse",
  "type": "object",
  "required": [
    "dispatchId",
    "provider",
    "model",
    "skills",
    "query",
    "status",
    "partial",
    "reply",
    "usage"
  ],
  "additionalProperties": false,
  "properties": {
    "dispatchId": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skillContracts": {
      "type": "array",
      "items": {
        "$ref": "./sandbox-consumer-view.schema.json"
      }
    },
    "query": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "partial_failed", "failed", "cancelled"]
    },
    "partial": {
      "type": "boolean"
    },
    "reply": {
      "type": "string"
    },
    "finishReason": {
      "type": "string"
    },
    "usage": {
      "$ref": "./llm-dispatch-resource.schema.json#/properties/usage"
    },
    "errorCode": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "sessionSegmentId": {
      "type": "string"
    },
    "requestTurnId": {
      "type": "string"
    },
    "responseTurnId": {
      "type": "string"
    },
    "continuityPreviewId": {
      "type": "string"
    },
    "continuityApplied": {
      "type": "boolean"
    },
    "continuityStatus": {
      "type": "string",
      "enum": ["applied", "empty", "disabled", "blocked", "partial", "failed"]
    },
    "continuityIncludedCount": {
      "type": "integer",
      "minimum": 0
    },
    "continuityExcludedCount": {
      "type": "integer",
      "minimum": 0
    },
    "toolTrace": {
      "type": "array",
      "description": "Stage 9.0: every tool call the turn made, in order. Absent when the model answered without tools.",
      "items": {
        "type": "object",
        "required": ["round", "dispatchId", "callId", "name", "arguments", "output", "isError", "durationMs"],
        "additionalProperties": false,
        "properties": {
          "round": { "type": "integer", "minimum": 0 },
          "dispatchId": { "type": "string" },
          "callId": { "type": "string" },
          "name": { "type": "string" },
          "arguments": { "type": "string", "description": "The raw JSON arguments text the model produced." },
          "output": { "type": "string", "description": "What the model saw back, already truncated." },
          "isError": { "type": "boolean" },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
