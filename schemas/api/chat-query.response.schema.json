{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/chat-query.response.schema.json",
  "title": "ChatQueryResponse",
  "type": "object",
  "required": [
    "dispatchId",
    "provider",
    "model",
    "skills",
    "query",
    "status",
    "partial",
    "reply",
    "usage"
  ],
  "additionalProperties": false,
  "properties": {
    "turnId": {
      "type": "string",
      "description": "The turn's trace id, readable at GET /v1/turn-traces/{turnId}."
    },
    "dispatchId": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skillContracts": {
      "type": "array",
      "items": {
        "$ref": "./sandbox-consumer-view.schema.json"
      }
    },
    "query": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "partial_failed", "failed", "cancelled"]
    },
    "partial": {
      "type": "boolean"
    },
    "reply": {
      "type": "string"
    },
    "finishReason": {
      "type": "string"
    },
    "usage": {
      "$ref": "./llm-dispatch-resource.schema.json#/properties/usage"
    },
    "errorCode": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "sessionSegmentId": {
      "type": "string"
    },
    "requestTurnId": {
      "type": "string"
    },
    "responseTurnId": {
      "type": "string"
    },
    "continuityPreviewId": {
      "type": "string"
    },
    "continuityApplied": {
      "type": "boolean"
    },
    "continuityStatus": {
      "type": "string",
      "enum": ["applied", "empty", "disabled", "blocked", "partial", "failed"]
    },
    "continuityIncludedCount": {
      "type": "integer",
      "minimum": 0
    },
    "continuityExcludedCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
