{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/provider-resource.schema.json",
  "title": "ProviderProfile",
  "type": "object",
  "required": [
    "providerId",
    "title",
    "family",
    "authMode",
    "source",
    "modelSelectionMode",
    "registered",
    "configured",
    "ready",
    "default",
    "effectiveTimeoutMs",
    "effectiveMaxRetries",
    "secretConfigured",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "providerId": { "type": "string" },
    "title": { "type": "string" },
    "family": { "type": "string", "enum": ["builtin_echo", "openai_compatible", "anthropic_messages", "openai_responses", "claude_code_cli", "codex_cli"] },
    "authMode": { "type": "string", "enum": ["none", "api_key", "local_cli_bridge"] },
    "source": { "type": "string", "enum": ["builtin", "config", "managed"] },
    "modelSelectionMode": { "type": "string", "enum": ["fixed", "open"] },
    "knownModels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "registered": { "type": "boolean" },
    "configured": { "type": "boolean" },
    "ready": { "type": "boolean" },
    "default": { "type": "boolean" },
    "baseURL": { "type": "string" },
    "requestURL": { "type": "string" },
    "defaultModel": { "type": "string" },
    "effectiveModel": { "type": "string" },
    "effectiveTimeoutMs": { "type": "integer", "minimum": 1 },
    "effectiveMaxRetries": { "type": "integer", "minimum": 0 },
    "secretConfigured": { "type": "boolean" },
    "secretRef": { "type": "string" },
    "capabilities": {
      "type": "object",
      "required": ["chat", "stream"],
      "additionalProperties": false,
      "properties": {
        "chat": { "type": "boolean" },
        "stream": { "type": "boolean" },
        "coding": { "type": "boolean" },
        "toolUse": { "type": "boolean" }
      }
    },
    "authStatus": {
      "type": "string",
      "enum": ["unknown", "login_required", "pending_login", "authenticated", "revoked", "error"]
    },
    "cliAvailable": { "type": "boolean" },
    "accountLabel": { "type": "string" },
    "accountId": { "type": "string" },
    "plan": { "type": "string" },
    "authMethod": { "type": "string" },
    "loginCommand": {
      "type": "array",
      "items": { "type": "string" }
    },
    "logoutCommand": {
      "type": "array",
      "items": { "type": "string" }
    },
    "availableModelCount": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
