{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/sandbox-profile.schema.json",
  "title": "SandboxProfile",
  "type": "object",
  "required": [
    "profileId",
    "title",
    "description",
    "backendKind",
    "backendCapability",
    "defaultWorkDir",
    "filesystemPolicy",
    "networkPolicy",
    "envPolicy",
    "approvalPolicy",
    "processPolicy",
    "defaultTimeoutMs",
    "maxTimeoutMs",
    "restartable",
    "source",
    "active"
  ],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "profileId": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "backendKind": {
      "type": "string",
      "enum": ["subprocess", "docker", "ssh", "remote"]
    },
    "backendCapability": {
      "$ref": "./sandbox-backend-capability.schema.json"
    },
    "defaultWorkDir": { "type": "string" },
    "filesystemPolicy": {
      "$ref": "./sandbox-filesystem-policy.schema.json"
    },
    "networkPolicy": {
      "$ref": "./sandbox-network-policy.schema.json"
    },
    "envPolicy": {
      "$ref": "./sandbox-env-policy.schema.json"
    },
    "approvalPolicy": {
      "$ref": "./sandbox-approval-policy.schema.json"
    },
    "processPolicy": {
      "$ref": "./sandbox-process-policy.schema.json"
    },
    "defaultTimeoutMs": { "type": "integer", "minimum": 1 },
    "maxTimeoutMs": { "type": "integer", "minimum": 1 },
    "restartable": { "type": "boolean" },
    "source": { "type": "string", "enum": ["builtin"] },
    "active": { "type": "boolean" },
    "isolation": {
      "description": "tenant: each run gets its own container built from the acting tenant alone (only its workspace, a per-tenant non-root uid, no capabilities, read-only root filesystem, cgroup limits, no network); request mounts and network are refused. Absent means none.",
      "type": "string",
      "enum": ["none", "tenant"]
    }
  }
}
