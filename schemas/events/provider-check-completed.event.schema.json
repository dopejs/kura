{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/provider-check-completed.event.schema.json",
  "title": "ProviderCheckCompletedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "provider" },
        "name": { "const": "provider.check_completed" },
        "payload": {
          "type": "object",
          "required": ["providerId", "family", "authMode", "status", "model", "endpoint", "usage"],
          "additionalProperties": false,
          "properties": {
            "providerId": { "type": "string" },
      "family": { "type": "string", "enum": ["builtin_echo", "openai_compatible", "anthropic_messages", "openai_responses", "claude_code_cli", "codex_cli"] },
      "authMode": { "type": "string", "enum": ["none", "api_key", "local_cli_bridge"] },
            "status": { "type": "string", "enum": ["passed"] },
            "model": { "type": "string" },
            "endpoint": { "type": "string" },
            "usage": {
              "type": "object",
              "required": ["inputTokens", "outputTokens", "totalTokens"],
              "additionalProperties": false,
              "properties": {
                "inputTokens": { "type": "integer", "minimum": 0 },
                "outputTokens": { "type": "integer", "minimum": 0 },
                "totalTokens": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  ]
}
