{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/work-item-opened.event.schema.json",
  "title": "WorkItemOpenedEvent",
  "description": "An item was accepted and its mandate recorded. Carries no message bodies (work-items.md \u00a710).",
  "type": "object",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "tenantId"
      ],
      "properties": {
        "category": {
          "const": "work_item"
        },
        "name": {
          "const": "work_item.opened"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "work_item"
            },
            "id": {
              "type": "string"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "itemId",
            "basis",
            "strength",
            "threadId"
          ],
          "additionalProperties": false,
          "properties": {
            "itemId": {
              "type": "string"
            },
            "basis": {
              "type": "string",
              "enum": [
                "api",
                "im_mention",
                "im_direct",
                "rule"
              ]
            },
            "strength": {
              "type": "string",
              "enum": [
                "explicit",
                "inferred"
              ]
            },
            "threadId": {
              "type": "string"
            },
            "roundSeq": {
              "type": "integer",
              "minimum": 1
            },
            "requestId": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
