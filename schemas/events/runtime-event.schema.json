{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/runtime-event.schema.json",
  "title": "RuntimeEvent",
  "type": "object",
  "required": ["eventId", "sequence", "category", "name", "occurredAt", "resource", "scope"],
  "additionalProperties": false,
  "properties": {
    "tenantId": {
      "type": "string",
      "description": "Roadmap 35: tenant owner of the event. Optional during the staged rollout — omitted on global-category events (mcp, provider, system, daemon.migration, connector_global, capability_global) and on tenant-owned events written before the per-domain backfill completes."
    },
    "eventId": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "session",
        "run",
        "workflow",
        "step",
        "tool_call",
        "policy",
        "provider",
        "connector",
        "capability",
        "llm",
        "artifact",
        "sandbox",
        "mcp",
        "schedule",
        "integration",
        "delivery",
        "calendar",
        "mail",
        "reminder",
        "evaluation",
        "tenant",
        "work_item"
      ]
    },
    "name": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "resource": {
      "$ref": "#/$defs/resource"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "workflowStepId": {
          "type": "string"
        },
        "scheduleId": {
          "type": "string"
        },
        "scheduleAttemptId": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "computerUseSessionId": {
          "type": "string"
        },
        "computerUseActionId": {
          "type": "string"
        },
        "connectorId": {
          "type": "string"
        },
        "capabilityId": {
          "type": "string"
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    }
  }
}
