{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/llm-dispatch-cancelled.event.schema.json",
  "title": "LLMDispatchCancelledEvent",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "category": {
          "const": "llm"
        },
        "name": {
          "const": "llm.dispatch.cancelled"
        },
        "payload": {
          "type": "object",
          "required": ["provider", "model", "status", "attemptCount", "finishReason", "usage", "errorCode", "error"],
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "status": { "type": "string", "enum": ["cancelled"] },
            "attemptCount": { "type": "integer", "minimum": 1 },
            "finishReason": { "type": "string" },
            "usage": {
              "type": "object",
              "required": ["inputTokens", "outputTokens", "totalTokens"],
              "additionalProperties": false,
              "properties": {
                "inputTokens": { "type": "integer", "minimum": 0 },
                "outputTokens": { "type": "integer", "minimum": 0 },
                "totalTokens": { "type": "integer", "minimum": 0 },
                "cacheReadInputTokens": { "type": "integer", "minimum": 0, "description": "Part of inputTokens read from the provider's prompt cache; omitted when zero." },
                "cacheCreationInputTokens": { "type": "integer", "minimum": 0, "description": "Part of inputTokens written to the provider's prompt cache; omitted when zero." }
              }
            },
            "errorCode": { "type": "string" },
            "error": { "type": "string" },
            "skills": {
              "type": "array",
              "items": { "type": "string" }
            },
            "skillContracts": {
              "type": "array",
              "items": {
                "$ref": "../api/sandbox-consumer-view.schema.json"
              }
            }
          }
        }
      }
    }
  ]
}
