{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/work-item-attention-raised.event.schema.json",
  "title": "WorkItemAttentionRaisedEvent",
  "description": "A round left its item waiting on a person (work-items.md \u00a77): its report asked a question (kind question), or one of its tool calls gave up waiting on an approval that is still pending (kind approval, with the approval's id). The question itself is not carried. Carries no message bodies (work-items.md \u00a710).",
  "type": "object",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "tenantId"
      ],
      "properties": {
        "category": {
          "const": "work_item"
        },
        "name": {
          "const": "work_item.attention_raised"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "work_item"
            },
            "id": {
              "type": "string"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "itemId",
            "basis",
            "roundSeq"
          ],
          "additionalProperties": false,
          "properties": {
            "itemId": {
              "type": "string"
            },
            "basis": {
              "type": "string",
              "enum": [
                "api",
                "im_mention",
                "im_direct",
                "rule"
              ]
            },
            "roundSeq": {
              "type": "integer",
              "minimum": 1
            },
            "optionCount": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "enum": [
                "question",
                "approval"
              ]
            },
            "approvalId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
