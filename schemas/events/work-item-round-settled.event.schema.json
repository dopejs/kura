{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/work-item-round-settled.event.schema.json",
  "title": "WorkItemRoundSettledEvent",
  "description": "A round ended: with a report (state settled; outcome is the report status, or report_unreadable) or without one (state failed; outcome is the turn's error code). Carries no message bodies (work-items.md \u00a710).",
  "type": "object",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "tenantId"
      ],
      "properties": {
        "category": {
          "const": "work_item"
        },
        "name": {
          "const": "work_item.round_settled"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "work_item"
            },
            "id": {
              "type": "string"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "itemId",
            "basis",
            "roundSeq",
            "requestId",
            "state",
            "outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "itemId": {
              "type": "string"
            },
            "basis": {
              "type": "string",
              "enum": [
                "api",
                "im_mention",
                "im_direct",
                "rule"
              ]
            },
            "roundSeq": {
              "type": "integer",
              "minimum": 1
            },
            "requestId": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "settled",
                "failed"
              ]
            },
            "outcome": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            },
            "turnId": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
