{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/work-item-attention-cleared.event.schema.json",
  "title": "WorkItemAttentionClearedEvent",
  "description": "The item no longer waits on a person (work-items.md \u00a77). by round: a person's message answered the question and the round that reads it cleared it (roundSeq). by answer: POST /v1/work-items/{id}/answer answered it. by approval: the approval it waited on was resolved (approvalId). Before slice 5 only rounds cleared attention, and `by` was absent. Carries no message bodies (\u00a710).",
  "type": "object",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "tenantId"
      ],
      "properties": {
        "category": {
          "const": "work_item"
        },
        "name": {
          "const": "work_item.attention_cleared"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "work_item"
            },
            "id": {
              "type": "string"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "itemId",
            "basis"
          ],
          "additionalProperties": false,
          "properties": {
            "itemId": {
              "type": "string"
            },
            "basis": {
              "type": "string",
              "enum": [
                "api",
                "im_mention",
                "im_direct",
                "rule"
              ]
            },
            "roundSeq": {
              "type": "integer",
              "minimum": 1
            },
            "by": {
              "type": "string",
              "enum": [
                "round",
                "answer",
                "approval"
              ]
            },
            "approvalId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
